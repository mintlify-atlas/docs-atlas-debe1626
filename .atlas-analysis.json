  "projectType": "sdk-library",
  "projectName": "Interprocess",
  "projectDescription": "A cross-platform interprocess communication library for Rust that exposes local sockets, unnamed pipes, FIFO files, and Windows named pipes through a unified, portable interface with optional Tokio async support.",
